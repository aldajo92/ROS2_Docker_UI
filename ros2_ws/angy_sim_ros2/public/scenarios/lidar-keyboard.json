        "thickness": 0.2
      }
    },
    {
      "kind": "static_obstacle",
      "id": "wall_east",
      "shape": "rectangle",
      "rectangle": {
        "mode": "segment",
        "start": { "x": 4, "y": -4 },
        "end":   { "x": 4, "y":  4 },
        "thickness": 0.2
      }
    },
    {
      "kind": "static_obstacle",
      "id": "wall_west",
