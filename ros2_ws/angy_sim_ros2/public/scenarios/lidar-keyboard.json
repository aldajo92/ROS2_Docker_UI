      "kind": "vehicle",
      "id": "ego",
      "pose": { "x": 0, "y": 0, "yaw": 0 },
      "controls": { "v": 0, "w": 0 },
      "radius": 0.4
    },
    {
      "kind": "static_obstacle",
      "id": "wall_north",
      "shape": "rectangle",
      "rectangle": {
        "mode": "segment",
        "start": { "x": -4, "y": 4 },
        "end":   { "x":  4, "y": 4 },
        "thickness": 0.2
      }
    },
    {
      "kind": "static_obstacle",
      "id": "wall_south",
      "shape": "rectangle",
