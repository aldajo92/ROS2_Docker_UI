{
  "name": "lidar-keyboard",
  "description": "Drive the ego vehicle with the keyboard while the front-mounted 2D lidar scans surrounding obstacles. ArrowUp/I forward, ArrowDown/K reverse, ArrowLeft/J turn left, ArrowRight/L turn right.",
  "interaction": {
    "keyboardControl": {
      "enabled": true,
      "vehicleId": "ego",
      "forwardSpeed": 2.0,
      "reverseSpeed": 1.0,
      "angularSpeed": 1.5
    }
  },
  "entities": [
