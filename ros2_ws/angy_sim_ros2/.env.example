# angy_sim_ros2 — environment configuration
#
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Vite exposes any variable prefixed with `VITE_` to the browser bundle
# via `import.meta.env`. The simulation core never reads these — only
# `src/app/CommunicationProvider.tsx` consumes them, so swapping
# transports later only touches the composition root.

# Which Transport implementation the React shell builds.
#
# Allowed values:
#   none       — run the simulator standalone, no external comms (default)
#   mock       — in-process MockTransport (useful for UI prototyping)
#   memory     — in-process InMemoryTransport (microtask dispatch)
#   rosbridge  — RoslibRosbridgeTransport against rosbridge_server
#
# Unknown values fall back to `none` and log a warning.
VITE_TRANSPORT_KIND=rosbridge

# Rosbridge server URL. Only consumed when VITE_TRANSPORT_KIND=rosbridge.
# Defaults to ws://localhost:9090 when unset.
VITE_ROSBRIDGE_URL=ws://localhost:9090
